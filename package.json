{
  "name": "dotclaude",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Claude Code registry (skills, agents, commands, hooks) distributed via the shadcn GitHub registry.",
  "type": "module",
  "homepage": "https://dotclaude.khaledsaeed.tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KhaledSaeed18/dotclaude.git"
  },
  "license": "MIT",
  "author": "Khaled Saeed",
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "new": "tsx scripts/new.ts",
    "gen": "tsx scripts/gen.ts",
    "gen:check": "tsx scripts/gen.ts --check",
    "validate": "tsx scripts/validate.ts",
    "smoke": "tsx scripts/smoke.ts",
    "coverage": "tsx scripts/coverage.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "3.15.2"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.4",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.14",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
