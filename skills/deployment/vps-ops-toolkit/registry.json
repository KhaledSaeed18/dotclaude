        {
          "path": "templates/ops/health/ops.logrotate",
          "type": "registry:file",
          "target": ".claude/skills/vps-ops-toolkit/templates/ops/health/ops.logrotate"
        },
        {
          "path": "templates/ops/install.sh",
          "type": "registry:file",
          "target": ".claude/skills/vps-ops-toolkit/templates/ops/install.sh"
