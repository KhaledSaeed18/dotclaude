{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "vps-ops-toolkit",
      "type": "registry:item",
      "title": "Vps Ops Toolkit",
      "description": "Install host operations on a VPS, with a cron health check that alerts on change, restore-verified encrypted database backups, and an installer. Use when a server has no monitoring or backups, or when adding a resource to them.",
      "author": "Khaled Saeed",
      "categories": [
        "deployment"
      ],
      "docs": "https://github.com/KhaledSaeed18/dotclaude/tree/main/skills/deployment/vps-ops-toolkit",
      "meta": {
        "type": "skill"
      },
      "files": [
        {
          "path": "SKILL.md",
          "type": "registry:file",
          "target": ".claude/skills/vps-ops-toolkit/SKILL.md"
        },
        {
          "path": "templates/ops/backup/backup.cron",
          "type": "registry:file",
          "target": ".claude/skills/vps-ops-toolkit/templates/ops/backup/backup.cron"
        },
        {
          "path": "templates/ops/backup/backup.env.example",
          "type": "registry:file",
          "target": ".claude/skills/vps-ops-toolkit/templates/ops/backup/backup.env.example"
        },
        {
          "path": "templates/ops/backup/backup.sh",
          "type": "registry:file",
          "target": ".claude/skills/vps-ops-toolkit/templates/ops/backup/backup.sh"
        },
        {
          "path": "templates/ops/backup/fingerprint.sql",
          "type": "registry:file",
          "target": ".claude/skills/vps-ops-toolkit/templates/ops/backup/fingerprint.sql"
        },
        {
          "path": "templates/ops/backup/snapshot.sql",
          "type": "registry:file",
          "target": ".claude/skills/vps-ops-toolkit/templates/ops/backup/snapshot.sql"
        },
        {
          "path": "templates/ops/health/health-check.cron",
          "type": "registry:file",
          "target": ".claude/skills/vps-ops-toolkit/templates/ops/health/health-check.cron"
        },
        {
          "path": "templates/ops/health/health-check.sh",
          "type": "registry:file",
          "target": ".claude/skills/vps-ops-toolkit/templates/ops/health/health-check.sh"
        },
        {
          "path": "templates/ops/health/health.env.example",
          "type": "registry:file",
