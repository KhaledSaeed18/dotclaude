# Copy to /etc/app-backup.env (root:root, mode 600) on the server.

# Coolify resource name of the database (label coolify.resourceName).
DB_RESOURCE_NAME=my-db
PG_ROLE=app
PG_DATABASE=app

# Must match the production Postgres version.
VERIFY_IMAGE=postgres:17-alpine

# Public key only (age1...). The private key stays with the owner, offline.
AGE_RECIPIENT=

BACKUP_DIR=/var/backups/app-db
BACKUP_PREFIX=db_
KEEP_LOCAL=14

# Leave OFFSITE_REMOTE empty to skip the git copy.
OFFSITE_REMOTE=
OFFSITE_DIR=/var/backups/app-offsite
OFFSITE_SSH_KEY=/root/.ssh/backup_repo_key
KEEP_OFFSITE=14

# Optional Discord webhook for failure alerts.
ALERT_WEBHOOK_URL=
