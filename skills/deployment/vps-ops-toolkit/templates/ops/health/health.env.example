# Copy to /etc/app-health.env (root:root, mode 600). Every setting is
# optional; the script's defaults apply when a line is missing.

# Discord webhook for alerts. Without it, alerts are only written to the log.
ALERT_WEBHOOK_URL=

# Coolify resource names that must be running and healthy.
RESOURCES="my-api my-db my-web"
# Domains whose certificate must verify for the name and not be near expiry.
DOMAINS="api.example.com app.example.com coolify.example.com"
# Public readiness probe expected to answer 200.
READINESS_URL=https://api.example.com/api/v1/health/ready

# BACKUP_DIR=/var/backups/app-db
# BACKUP_PREFIX=db_
# BACKUP_MAX_AGE_HOURS=30
# DISK_WARN_PERCENT=85
# MEMORY_WARN_MB=512
# CERT_WARN_DAYS=14
