{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "nextjs-coolify-image",
      "type": "registry:item",
      "title": "Nextjs Coolify Image",
      "description": "Package a Next.js app as a runtime-only container image with a health probe and a fast shutdown. Use when containerising a Next.js app, when its image is large or slow, or when a rolling update drops requests.",
      "author": "Khaled Saeed",
      "categories": [
        "deployment"
      ],
      "docs": "https://github.com/KhaledSaeed18/dotclaude/tree/main/skills/deployment/nextjs-coolify-image",
      "meta": {
        "type": "skill"
      },
      "files": [
        {
          "path": "SKILL.md",
          "type": "registry:file",
          "target": ".claude/skills/nextjs-coolify-image/SKILL.md"
        },
        {
          "path": "templates/Dockerfile",
          "type": "registry:file",
          "target": ".claude/skills/nextjs-coolify-image/templates/Dockerfile"
        },
        {
          "path": "templates/dockerignore",
          "type": "registry:file",
          "target": ".claude/skills/nextjs-coolify-image/templates/dockerignore"
        },
        {
          "path": "templates/healthcheck.js",
          "type": "registry:file",
          "target": ".claude/skills/nextjs-coolify-image/templates/healthcheck.js"
        },
        {
          "path": "templates/healthz-route.ts",
          "type": "registry:file",
          "target": ".claude/skills/nextjs-coolify-image/templates/healthz-route.ts"
        },
        {
          "path": "templates/shutdown.cjs",
          "type": "registry:file",
          "target": ".claude/skills/nextjs-coolify-image/templates/shutdown.cjs"
        }
      ]
    }
  ]
}
